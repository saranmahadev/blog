# Public Firebase web config (safe to expose; access is enforced by security rules).
# Copy to .env for local work. In CI these come from repository variables.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Set to "true" to use the local emulators (pnpm emulators) instead of the real project.
PUBLIC_USE_EMULATORS=
