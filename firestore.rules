rules_version = '2';

// Default deny. Every collection that exists is listed here with the narrowest access it needs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Roles are custom claims set by a Cloud Function, never by a client.
    function hasRole(r) { return signedIn() && request.auth.token.role == r; }
    function isStaff() { return hasRole('admin') || hasRole('moderator'); }

    // users/{uid}: the profile a reader edits. After creation, role, createdAt and email are immutable from clients.
    match /users/{uid} {
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();
      // A reader may create only their own, plain-"user" profile. The authoritative role is the custom claim set by the server.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'bio', 'preferences', 'createdAt'])
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 280
        && request.resource.data.preferences is map;
      allow delete: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'preferences', 'inboxSeenAt'])
        // "I have read my inbox up to now": only ever set to the server time.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['inboxSeenAt']) || request.resource.data.inboxSeenAt == request.time)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 40
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 280))
        && (!('preferences' in request.resource.data) || request.resource.data.preferences is map);
    }

    // comments/{id}: private conversations. Created only by the postComment function. A thread is visible to the
    // reader who started it (threadOwnerId) and to the author (role "admin"), and to nobody else.
    match /comments/{id} {
      allow get, list: if signedIn() && (resource.data.threadOwnerId == request.auth.uid || hasRole('admin'));
      allow create: if false;
      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(resource.data.authorId) || hasRole('admin');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
