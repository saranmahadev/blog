rules_version = '2';

// Default deny. Every collection that exists is listed here with the narrowest access it needs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // The author is the verified owner of this mailbox (no role to configure). Keep in sync with AUTHOR_EMAIL in src/lib/site.ts and functions/src/index.ts.
    function isAuthor() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'mail@saranmahadev.in'; }

    // users/{uid}: one small document per reader, read once at sign-in. Posts are static, so it only holds post slugs:
    //   b bookmarks, p furthest read, s settings, n unread messages (the server raises it; the reader can only reset it), m latest message time.
    function validState() {
      let d = request.resource.data;
      return (!('b' in d) || (d.b is map && d.b.size() <= 200))
        && (!('p' in d) || (d.p is map && d.p.size() <= 500))
        && (!('s' in d) || (d.s is map && d.s.keys().hasOnly(['t']) && (!('t' in d.s) || d.s.t in ['light', 'dark', 'system'])));
    }
    match /users/{uid} {
      // Only the reader sees their own record. The author cannot read readers' bookmarks or reading progress.
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['b', 'p', 's', 'n', 'm'])
        && (!('n' in request.resource.data) || request.resource.data.n == 0)
        && !('m' in request.resource.data)
        && validState();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['b', 'p', 's', 'n'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['n']) || request.resource.data.n == 0)
        && validState();
      allow delete: if false;
    }

    // comments/{id}: private conversations. Created only by the postComment function. A thread is visible to the
    // reader who started it (threadOwnerId) and to the author (the verified owner of the author address), and to nobody else.
    match /comments/{id} {
      allow get, list: if signedIn() && (resource.data.threadOwnerId == request.auth.uid || isAuthor());
      allow create: if false;
      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(resource.data.authorId) || isAuthor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
