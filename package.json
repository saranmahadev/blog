    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/inter": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.10",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
