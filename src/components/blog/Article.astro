---
import { render } from 'astro:content';
import type { Post, Series } from '@/lib/content';
import { formatDate, readingTime } from '@/lib/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TagPill from './TagPill.astro';
import SeriesNav from './SeriesNav.astro';

interface Props { post: Post; series?: Series }
const { post, series } = Astro.props;
const { Content } = await render(post.entry);
const { data } = post;
const minutes = readingTime(post.entry.body ?? '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  author: { '@type': 'Person', name: data.author },
  datePublished: data.date.toISOString(),
  dateModified: (data.updated ?? data.date).toISOString(),
  ...(data.cover && { image: new URL(data.cover.image, Astro.site).href }),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={data.canonical}
  image={data.cover?.image}
  type="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-[680px] px-5 pt-12 sm:pt-16">
    <header>
      {series && (
        <p class="mb-4">
          <TagPill label={series.entry.data.title} href={series.url} />
        </p>
      )}
      <h1 class="text-4xl sm:text-[2.75rem] font-bold tracking-tight leading-[1.15]">{data.title}</h1>
      <p class="mt-4 font-serif text-xl sm:text-[1.375rem] text-muted leading-snug">{data.description}</p>
      <div class="mt-8 py-4 border-y border-line flex items-center gap-3 text-sm">
        <span class="clay-sm tone-peach size-10 grid place-items-center font-bold" aria-hidden="true">{data.author[0]}</span>
        <div>
          <p class="font-medium">{data.author}</p>
          <p class="text-muted">
            <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>{' '}
            · {minutes} min read
          </p>
        </div>
      </div>
    </header>

    {data.cover && (
      <figure class="mt-10">
        <img src={data.cover.image} alt={data.cover.alt} class="w-full rounded-2xl" loading="eager" />
      </figure>
    )}

    <div class="prose-article mt-10">
      <Content />
    </div>

    {data.tags.length > 0 && (
      <ul class="mt-12 flex flex-wrap gap-2" aria-label="Tags">
        {data.tags.map((t) => <li><TagPill label={t} /></li>)}
      </ul>
    )}

    {series && <SeriesNav series={series} current={post} />}
  </article>
</BaseLayout>
