---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContent, getRelated, slugifyTag, type Post, type Series } from '@/lib/content';
import { formatDate, readingTime } from '@/lib/site';
import Pill from './Pill.astro';
import Comments from '@/components/comments/Comments.tsx';
import BookmarkButton from '@/components/library/BookmarkButton.tsx';
import ReadTracker from '@/components/library/ReadTracker.tsx';
import ReadBadge from '@/components/library/ReadBadge.tsx';
import { imaxt, ImaxtCover } from '@/components/imaxt';
import { isImageCover } from '@/lib/cover';
import SponsorSlot from '@/components/sponsor/SponsorSlot.astro';

interface Props { post: Post; series?: Series }
const { post, series } = Astro.props;
const { Content, headings } = await render(post.entry);
const { data } = post;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { posts: all } = await getContent();
const related = getRelated(post, all);
const minutes = readingTime(post.entry.body ?? '');
const idx = series ? series.posts.findIndex((p) => p.key === post.key) : -1;
const prev = series?.posts[idx - 1];
const next = series?.posts[idx + 1];

const ogImage = isImageCover(data.cover) ? data.cover.image : `/og/${post.key}.png`;
const abs = (path: string) => new URL(path, Astro.site).href;
const crumbs = [
  { name: 'Home', url: '/' },
  ...(series ? [{ name: series.entry.data.title, url: series.url }] : []),
  { name: data.title, url: post.url },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: data.title,
      description: data.description,
      author: { '@type': 'Person', name: data.author },
      datePublished: data.date.toISOString(),
      dateModified: (data.updated ?? data.date).toISOString(),
      image: abs(ogImage),
      mainEntityOfPage: abs(post.url),
      keywords: data.tags.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.url) })),
    },
  ],
};
---

<BaseLayout title={data.title} description={data.description} canonical={data.canonical} image={ogImage} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {series && <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`${series.entry.data.title} (RSS)`} href={`${series.url}rss.xml`} />
    <link rel="alternate" type="application/atom+xml" title={`${series.entry.data.title} (Atom)`} href={`${series.url}atom.xml`} />
    <link rel="alternate" type="application/feed+json" title={`${series.entry.data.title} (JSON Feed)`} href={`${series.url}feed.json`} />
  </Fragment>}

  <div class="readbar" aria-hidden="true"><i id="readbar" style="width:0"></i></div>

  <section data-pagefind-body class:list={['art-band', post.tone ? `tone-${post.tone}` : 'art-neutral']}>
    <div hidden>
      <span data-pagefind-filter="kind:Post"></span>
      {series && <span data-pagefind-filter={`series:${series.entry.data.title}`}></span>}
      {data.tags.map((t) => <span data-pagefind-filter={`topic:${t}`}></span>)}
    </div>
    <div class="wrap">
      <div class="art-hero">
        <div>
          <div class="mono" data-pagefind-ignore style="margin-bottom:26px">
            <a href="/">Home</a>{' / '}
            {series ? <><a href={series.url}>{series.entry.data.title}</a>{` / Part ${idx + 1}`}</> : 'Post'}
          </div>
          <h1 class="disp art-h">{data.title}</h1>
          <p class="serif" style="font-size:26px;line-height:1.4;max-width:46ch;margin-top:22px">{data.description}</p>
          <div class="row" style="margin-top:30px;gap:14px;flex-wrap:wrap">
            <span class="av tone-ink" aria-hidden="true">{data.author[0]}</span>
            <div>
              <div style="font-weight:700">{data.author}</div>
              <div class="meta" style="color:inherit;opacity:.8"><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time> · {minutes} min read</div>
            </div>
            <span class="sp"></span>
            {data.tags.map((t) => <Pill label={t} href={`/topics/${slugifyTag(t)}/`} />)}
          </div>
        </div>
        {isImageCover(data.cover)
          ? <img src={data.cover.image} alt={data.cover.alt} class="rounded-2xl w-full" style="border:1.5px solid var(--line);box-shadow:var(--hard)" />
          : <ImaxtCover cover={data.cover} title={data.title} tone="ink" ratio="4 / 3" caption={series ? `${series.entry.data.title} / ${String(idx + 1).padStart(2, '0')}` : 'Post'} style="box-shadow:var(--hard)" />}
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="art-grid">
      <aside class="rail rail-l" aria-label="Contents and series">
        {toc.length > 1 && (
          <nav aria-label="On this page">
            <div class="mono" style="margin-bottom:10px">On this page</div>
            <ul class="toc">
              {toc.map((h) => <li class:list={[h.depth === 3 && 'l2']}><a class="toc-link" href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </nav>
        )}
        {series && (
          <nav class:list={['slab', `tone-${series.tone}`]} style="padding:18px" aria-label="Series">
            <div class="mono">Part {idx + 1} of {series.posts.length}</div>
            <div class="head" style="font-size:22px;margin:4px 0 12px"><a href={series.url}>{series.entry.data.title}</a></div>
            <ol style="font-size:14px">
              {series.posts.map((p, n) => (
                <li class="row" style="padding:5px 0;gap:8px;align-items:baseline">
                  <span class="mono">{String(n + 1).padStart(2, '0')}</span>
                  {p.key === post.key ? <strong>{p.data.title}</strong> : <a href={p.url} style="text-decoration:underline">{p.data.title}</a>}
                  <ReadBadge client:idle slug={p.key} />
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <div class="prose-col">
        <ReadTracker client:idle slug={post.key} />
        <article class="prose" data-pagefind-body>
          <Content components={imaxt} />
        </article>

        <SponsorSlot size="end" postKey={post.key} />

        {series && (prev || next) && (
          <nav aria-label="More in this series" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:56px;max-width:720px;margin-inline:auto">
            {prev ? <a href={prev.url} class="slab hov" style="padding:20px;display:block"><span class="mono">Previous</span><div class="head" style="font-size:22px;margin-top:6px">← {prev.data.title}</div></a> : <span />}
            {next ? <a href={next.url} class:list={['slab', 'hov', `tone-${series.tone}`]} style="padding:20px;display:block"><span class="mono">Up next</span><div class="head" style="font-size:22px;margin-top:6px">{next.data.title} →</div></a> : <span />}
          </nav>
        )}

        <Comments client:visible postKey={post.key} />
      </div>

      <aside class="rail rail-r" aria-label="Actions and related">
        <div class="art-actions" role="toolbar" aria-label="Post actions">
          <BookmarkButton client:load slug={post.key} />
          <button class="ib sm" type="button" aria-label="Copy link" data-copy>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1" /></svg>
          </button>
          <button class="ib sm" type="button" aria-label="Share" data-share>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12v7a1 1 0 001 1h14a1 1 0 001-1v-7M16 6l-4-4-4 4M12 2v14" /></svg>
          </button>
        </div>
        <SponsorSlot size="rail" postKey={post.key} />
        {related.length > 0 && (
          <div>
            <div class="mono" style="margin-bottom:10px">Related</div>
            <ul>
              {related.map((p) => (
                <li style="padding:12px 0;border-top:1px solid var(--hair)">
                  <a class="head" style="font-size:18px" href={p.url}>{p.data.title}</a>
                  <div class="meta" style="margin-top:4px">{readingTime(p.entry.body ?? '')} min</div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  <div id="copied" class="toast copied-toast" role="status" hidden>Link copied</div>
</BaseLayout>

<script>
  const bar = document.getElementById('readbar');
  const update = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (bar) bar.style.width = (max > 0 ? Math.min(100, (h.scrollTop / max) * 100) : 0) + '%';
  };
  addEventListener('scroll', update, { passive: true });
  update();

  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
  const targets = links
    .map((l) => document.getElementById(decodeURIComponent(l.hash.slice(1))))
    .filter((t): t is HTMLElement => !!t);
  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && links.forEach((l) => l.classList.toggle('on', l.hash === '#' + e.target.id))),
      { rootMargin: '0px 0px -70% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }

  const toast = document.getElementById('copied');
  document.querySelector('[data-copy]')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      toast?.removeAttribute('hidden');
      setTimeout(() => toast?.setAttribute('hidden', ''), 2000);
    } catch {}
  });
  const share = document.querySelector<HTMLButtonElement>('[data-share]');
  if (share && !navigator.share) share.hidden = true;
  share?.addEventListener('click', () => navigator.share?.({ title: document.title, url: location.href }).catch(() => {}));
</script>
