---
import type { Post } from '@/lib/content';
import { formatDate, readingTime } from '@/lib/site';
import TagPill from './TagPill.astro';

interface Props { post: Post; seriesTitle?: string }
const { post, seriesTitle } = Astro.props;
const minutes = readingTime(post.entry.body ?? '');
---

<article class="py-8 border-b border-line first:pt-0 last:border-b-0">
  <div class="text-sm text-muted flex flex-wrap items-center gap-x-2 gap-y-1 mb-2">
    {seriesTitle && <TagPill label={seriesTitle} href={`/${post.seriesSlug}/`} />}
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
  </div>
  <a href={post.url} class="group block">
    <h2 class="text-2xl font-bold tracking-tight leading-snug group-hover:underline underline-offset-4 decoration-1">{post.data.title}</h2>
    <p class="mt-2 font-serif text-lg text-muted leading-snug">{post.data.description}</p>
  </a>
  {post.data.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {post.data.tags.slice(0, 3).map((t) => <TagPill label={t} />)}
    </div>
  )}
</article>
