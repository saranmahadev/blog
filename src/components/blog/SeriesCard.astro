---
import type { Series } from '@/lib/content';
import { toneFor } from '@/lib/site';

interface Props { series: Series }
const { series } = Astro.props;
---

<a href={series.url} class:list={['clay clay-press block p-5', `tone-${toneFor(series.slug)}`]}>
  <p class="text-xs uppercase tracking-wider text-muted font-medium">Series · {series.posts.length} {series.posts.length === 1 ? 'part' : 'parts'}</p>
  <h3 class="mt-1 text-lg font-bold tracking-tight leading-snug">{series.entry.data.title}</h3>
  <p class="mt-2 font-serif text-base text-muted leading-snug">{series.entry.data.description}</p>
</a>
