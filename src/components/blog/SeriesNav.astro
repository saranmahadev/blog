---
import type { Post, Series } from '@/lib/content';
import { toneFor } from '@/lib/site';

interface Props { series: Series; current: Post }
const { series, current } = Astro.props;
const i = series.posts.findIndex((p) => p.key === current.key);
const prev = series.posts[i - 1];
const next = series.posts[i + 1];
---

<nav aria-label="Series" class:list={['clay mt-14 p-6 sm:p-8', `tone-${toneFor(series.slug)}`]}>
  <p class="text-xs uppercase tracking-wider text-muted font-medium">Part {i + 1} of {series.posts.length}</p>
  <h2 class="mt-1 text-xl font-bold tracking-tight"><a href={series.url}>{series.entry.data.title}</a></h2>
  <ol class="mt-5 space-y-2 text-[0.95rem]">
    {series.posts.map((p, n) => (
      <li class="flex gap-3">
        <span class="text-muted tabular-nums w-5">{n + 1}.</span>
        {p.key === current.key
          ? <span class="font-semibold">{p.data.title}</span>
          : <a href={p.url} class="hover:underline underline-offset-4">{p.data.title}</a>}
      </li>
    ))}
  </ol>
  {(prev || next) && (
    <div class="mt-6 flex gap-3 justify-between text-sm font-medium">
      {prev ? <a href={prev.url} class="clay-sm clay-press tone-butter px-4 py-2">← Previous</a> : <span />}
      {next ? <a href={next.url} class="clay-sm clay-press tone-butter px-4 py-2">Next →</a> : <span />}
    </div>
  )}
</nav>
