---
import { ImaxtCover as PackageImaxtCover } from '@inflate-ai/imaxt-astro';
import type { Tone } from '@inflate-ai/imaxt-core';
import { isImaxtCover, type Cover } from '@/lib/cover';

interface Props {
  cover?: Cover;
  title: string;
  tone?: Tone;
  caption?: string;
  ratio?: string;
  style?: string;
}
const { cover, title, tone, caption, ratio, style } = Astro.props;
---

<PackageImaxtCover
  cover={isImaxtCover(cover) ? cover : undefined}
  title={title}
  tone={tone}
  caption={caption}
  ratio={ratio}
  style={style}
/>
