---
import { renderImaxtCover, type ImaxtCoverData } from '@inflate-ai/imaxt/core';
import { isImaxtCover, type Cover } from '@/lib/cover';

interface Props extends Omit<ImaxtCoverData, 'cover'> {
  cover?: Cover;
}
const { cover, title, tone, caption, ratio, style } = Astro.props;
---

<Fragment set:html={renderImaxtCover({ cover: isImaxtCover(cover) ? cover : undefined, title, tone, caption, ratio, style })} />
