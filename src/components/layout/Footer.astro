---
import { SITE, NAV } from '@/lib/site';
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-cols">
      <div>
        <div class="logo" style="font-size:24px"><i></i><span>{SITE.title}</span><small class="by mono">{SITE.byline}</small></div>
        <p class="serif" style="margin-top:16px;font-size:19px;max-width:30ch;color:#cfcbbf">{SITE.description}</p>
      </div>
      <div>
        <div class="mono foot-h">Read</div>
        <ul>
          <li><a href="/">Latest</a></li>
          <li><a href="/series/">Series</a></li>
        </ul>
      </div>
      <div>
        <div class="mono foot-h">Site</div>
        <ul>
          {NAV.filter((n) => n.href === '/about/').map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/advertise/">Advertise</a></li>
        </ul>
      </div>
      <div>
        <div class="mono foot-h">Legal</div>
        <ul>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/security/">Security</a></li>
        </ul>
      </div>
      <div>
        <div class="mono foot-h">Subscribe</div>
        <ul>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/atom.xml">Atom</a></li>
          <li><a href="/feed.json">JSON Feed</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-word disp" aria-hidden="true">{SITE.title}</div>
    <div class="row mono" style="margin-top:24px;color:#a8a498">
      <span>© {new Date().getFullYear()} {SITE.title} · {SITE.byline}</span>
      <span class="sp"></span>
      <span class="in-tag" style="font-size:11px;display:inline-flex;align-items:center;gap:6px">Proud to be Indian <svg role="img" aria-label="Indian flag" width="18" height="12" viewBox="0 0 18 12"><rect width="18" height="4" fill="#FF9933"/><rect y="4" width="18" height="4" fill="#fff"/><rect y="8" width="18" height="4" fill="#138808"/><circle cx="9" cy="6" r="1.5" fill="none" stroke="#000080" stroke-width=".5"/></svg></span>
      <span style="margin-left:16px">Built with Astro</span>
    </div>
  </div>
</footer>
