---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" noindex>
  <div class="mx-auto max-w-[680px] px-5 pt-24 text-center">
    <p class="clay tone-lilac inline-block px-6 py-2 text-sm font-medium">404</p>
    <h1 class="mt-6 text-4xl font-bold tracking-tight">This page wandered off.</h1>
    <p class="mt-4 font-serif text-xl text-muted">The link may be broken or the post moved.</p>
    <a href="/" class="clay-sm clay-press tone-peach mt-8 inline-block px-6 py-2.5 font-medium">Back home</a>
  </div>
</BaseLayout>
