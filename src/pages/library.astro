---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Library from '@/components/library/Library.tsx';
import { getContent } from '@/lib/content';
import { readingTime } from '@/lib/site';

const { posts } = await getContent();
const info = posts.map((p) => ({ slug: p.key, title: p.data.title, url: p.url, description: p.data.description, series: p.seriesTitle, minutes: readingTime(p.entry.body ?? '') }));
---

<BaseLayout title="Library" description="Your bookmarks and reading progress." noindex>
  <div class="wrap" data-pagefind-ignore style="padding-top:56px;padding-bottom:96px;max-width:920px">
    <div class="mono muted" style="margin-bottom:14px"><a href="/">Home</a> / Library</div>
    <h1 class="disp" style="font-size:clamp(56px,9vw,120px)">Library</h1>
    <p class="serif muted" style="font-size:20px;max-width:46ch;margin-top:12px">Your bookmarks and where you left off. Saved on this device, and on your account when you are signed in.</p>
    <Library client:load posts={info} />
  </div>
</BaseLayout>
